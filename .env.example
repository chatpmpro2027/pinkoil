# Copy to .env and fill in. Never commit real keys.
PORT=3000
# Public URL of the site (used for Stripe redirect URLs). No trailing slash.
BASE_URL=http://localhost:3000
# In production (set on Render): BASE_URL=https://www.pinkoil.net

# Stripe — https://dashboard.stripe.com/apikeys (use test keys first: sk_test_...)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=

# Optional: paid orders are POSTed here as JSON (e.g. a Zapier/Make hook, 3PL or Shopify Flow)
FULFILLMENT_WEBHOOK_URL=
# Optional: protects GET /api/admin/orders (send header "Authorization: Bearer <token>")
ADMIN_TOKEN=
